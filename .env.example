# Telegram
BOT_TOKEN=YOUR_BOT_TOKEN
# Comma-separated Telegram user IDs of admins
ADMIN_IDS=123456789,987654321

# API internal secret (generate with: python -c "import uuid; print(uuid.uuid4())")
BOT_SECRET=YOUR_BOT_SECRET_UUID
API_URL=http://api:8000

# Database — if you change POSTGRES_* vars, update DATABASE_URL accordingly
POSTGRES_USER=aleksschl
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aleksschl
DATABASE_URL=postgresql+asyncpg://aleksschl:CHANGE_ME@db:5432/aleksschl

# Redis
REDIS_URL=redis://redis:6379/0

# Payments (підпроєкт 7)
WAYFORPAY_MERCHANT_KEY=YOUR_WAYFORPAY_MERCHANT_KEY
MONOBANK_TOKEN=YOUR_MONOBANK_TOKEN
